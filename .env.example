### Database
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
#DB_SSL_MODE=disabled
TZ=Europe/Paris

### Database Migration
#TARGET_DB_HOST=
#TARGET_DB_PORT=3306
#TARGET_DB_NAME=
#DB_SSL_MODE=disabled
#TARGET_DB_USER=
#TARGET_DB_PASSWORD=

### Backup restoration
#FILE_NAME=

### AWS  S3 Storage
#AWS_ACCESS_KEY=
#AWS_SECRET_KEY=
#AWS_S3_BUCKET_NAME=
#AWS_S3_ENDPOINT=
#AWS_REGION=
#REMOTE_PATH=
#AWS_DISABLE_SSL=false
#AWS_FORCE_PATH_STYLE=true

### Backup Cron Expression
#BACKUP_CRON_EXPRESSION=@midnight
##Delete old backup created more than specified days ago
#BACKUP_RETENTION_DAYS=7
#BACKUP_RETENTION_COUNT=10

####SSH Storage
#SFTP_HOST=
#SFTP_PORT=22
#SFTP_USER=
#SFTP_PASSWORD=
#SFTP_IDENTITY_FILE=/tmp/id_ed25519
#SFTP_KNOWN_HOSTS=/config/known_hosts

####FTP Storage
#FTP_PASSWORD=
#FTP_HOST=
#FTP_USER=
#FTP_PORT=21
#REMOTE_PATH=

## Azure Blob storage
#AZURE_STORAGE_CONTAINER_NAME=
#AZURE_STORAGE_ACCOUNT_NAME=
#AZURE_STORAGE_ACCOUNT_KEY=

#### Backup encryption
#GPG_PUBLIC_KEY=/config/gnupg/public_key.asc
#GPG_PRIVATE_KEY=/config/gnupg/private_key.asc
#AGE_RECIPIENTS=age1...
#AGE_IDENTITY_FILE=/config/age/identity.txt
#GPG_PASSPHRASE=Your strong passphrase

## For multiple database backup on Docker or Docker in Swarm mode
#BACKUP_CONFIG_FILE=/config/config.yaml

### Database restoration
#FILE_NAME=

### Notification
#BACKUP_REFERENCE=K8s/Paris cluster

## Telegram
#TG_TOKEN=
#TG_CHAT_ID=

### Email
#MAIL_HOST=
#MAIL_PORT=
#MAIL_USERNAME=
#MAIL_PASSWORD=
#MAIL_FROM=Backup Jobs <backup-jobs@example.com>
#MAIL_TO=backup@example.com,me@example.com,team@example.com
#MAIL_TLS=starttls
#MAIL_INSECURE_SKIP_VERIFY=false

## Full reference: mysql-bkup config --env-docs
